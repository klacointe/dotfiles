#!/usr/bin/env bash
# Engine for the review-queue plugin (UI lives in ui.py, a stdlib-curses app).
#
#   review-queue --mine       the same UI for my own open PRs (CI, review decision, comments, conflicts)
#   review-queue              run the UI in this pane (restarted if it crashes; q quits)
#   review-queue --workspace  create/focus the "reviews" herdr workspace running the UI
#   review-queue --restore    (startup hook) start the UI in a restored, idle "reviews" workspace
#   review-queue --open URL [review|rereview|analyze|reply|ci]
#                             start Claude on the PR in a new workspace (REVIEW_QUEUE_MODE=split|tab to change)
#   review-queue --open-tab URL  same, in a new tab
#
# Reviews are read-only: `claude "/code-review <url>"` never posts comments.
set -uo pipefail

ROOT="${REVIEW_QUEUE_ROOT:-$HOME/dev/WTTJ}"
LABEL="${REVIEW_QUEUE_LABEL:-reviews}"
SELF="$(readlink -f "$0")"
HERE="$(dirname "$SELF")"

parse_pr() {  # sets url repo num dir; returns 1 for header/placeholder rows
  url="$1"
  case "$url" in https://github.com/*/pull/[0-9]*) ;; *) return 1 ;; esac
  repo="$(sed -E 's|.*/([^/]+)/pull/[0-9]+.*|\1|' <<<"$url")"
  num="${url##*/}"
  dir="$ROOT/$repo"; [ -d "$dir" ] || dir="$ROOT"
}

ACTION="review"   # review | rereview | analyze | reply | ci  (set from the 3rd argument of --open)

# What Claude is asked to do. Every prompt is read-only: nothing is posted, resolved or pushed
# without explicit approval. No quotes inside the prompts (they are wrapped in single quotes).
prompt_for() {  # $1 = action, $2 = url
  case "$1" in
    analyze) printf 'Analyze the pull request %s. Summarize what it changes and why, point out the risky parts and what deserves attention first, and list questions for the author. Read only: do not post, approve or comment anything on GitHub.' "$2" ;;
    reply)   printf 'Go through the unresolved review comments on the pull request %s (use gh api graphql on reviewThreads). For each thread, say whether it is addressed in the code, then draft a reply or a fix. Only show me the drafts: do not post, resolve or push anything without my explicit approval.' "$2" ;;
    ci)      printf 'CI is failing on the pull request %s. Use gh pr checks and the job logs to find the cause, explain it and suggest a fix. Read only: do not push or comment on GitHub.' "$2" ;;
    *)       printf '/code-review %s' "$2" ;;
  esac
}

label_prefix() {
  case "$ACTION" in analyze) echo analyze ;; reply) echo comments ;; ci) echo ci ;; *) echo review ;; esac
}

start_review() {  # $1 = pane id, $2 = url
  herdr pane send-text "$1" "claude '$(prompt_for "$ACTION" "$2")'"
  herdr pane send-keys "$1" enter
}

# MODE=split: Claude opens in a split next to the list (list stays visible).
# First review splits the list pane to the right; further ones stack below the last review.
open_review_split() {
  local url repo num dir me tab last new
  parse_pr "$1" || return 0
  me="${HERDR_PANE_ID:-$(herdr pane current | jq -r '.result.pane.pane_id')}"
  tab="$(herdr pane get "$me" | jq -r '.result.pane.tab_id')"
  last="$(herdr pane list | jq -r --arg t "$tab" --arg me "$me" \
    '[.result.panes[] | select(.tab_id==$t and .pane_id!=$me)] | last | .pane_id // empty')"
  if [ -n "$last" ]; then
    new="$(herdr pane split "$last" --direction down --cwd "$dir" --focus | jq -r '.result.pane.pane_id')"
  else
    new="$(herdr pane split "$me" --direction right --ratio 0.35 --cwd "$dir" --focus | jq -r '.result.pane.pane_id')"
  fi
  start_review "$new" "$url"
}

# Default: each review gets its own workspace ("review repo#N"), so the list stays untouched
# and the agent shows up in the sidebar. Re-clicking a PR focuses its existing workspace.
# REVIEW_QUEUE_FOCUS=1 jumps to the new workspace; default leaves you on the list.
open_review_workspace() {
  local url repo num dir name id pane focus=--no-focus
  parse_pr "$1" || return 0
  name="$(label_prefix) $repo#$num"
  id="$(herdr workspace list | jq -r --arg l "$name" '.result.workspaces[] | select(.label==$l) | .workspace_id' | head -1)"
  if [ -n "$id" ]; then
    herdr workspace focus "$id" >/dev/null
    return 0
  fi
  [ "${REVIEW_QUEUE_FOCUS:-0}" = 1 ] && focus=--focus
  pane="$(herdr workspace create --label "$name" --cwd "$dir" $focus | jq -r '.result.root_pane.pane_id')"
  start_review "$pane" "$url"
}

open_review() {
  case "${REVIEW_QUEUE_MODE:-workspace}" in
    split) open_review_split "$@" ;;
    tab)   open_review_tab "$@" ;;
    *)     open_review_workspace "$@" ;;
  esac
}

# Link click / no list pane: Claude opens in its own tab in the current workspace.
open_review_tab() {
  local url repo num dir ws pane
  parse_pr "$1" || return 0
  ws="$(herdr pane current | jq -r '.result.pane.workspace_id')"
  pane="$(herdr tab create --workspace "$ws" --cwd "$dir" --label "review $repo#$num" --focus \
    | jq -r '.result.root_pane.pane_id')"
  start_review "$pane" "$url"
}

# The "reviews" workspace has two tabs: "requested" (PRs waiting for my review) and "mine" (my own PRs).
# Creates whatever is missing and starts a UI in any tab whose pane is just an idle shell
# (after a reboot herdr restores the layout, not the running commands).
view_tab() {  # $1 = workspace id, $2 = label -> tab id (empty if none)
  herdr tab list | jq -r --arg w "$1" --arg l "$2" '[.result.tabs[] | select(.workspace_id==$w and .label==$l)] | first | .tab_id // empty'
}

start_view() {  # $1 = tab id, $2 = command, $3 = "fresh" if the tab was just created
  local pane title
  pane="$(herdr pane list | jq -r --arg t "$1" '[.result.panes[] | select(.tab_id==$t)] | first | .pane_id // empty')"
  [ -n "$pane" ] || return 0
  if [ "${3:-}" != fresh ]; then
    title="$(herdr pane get "$pane" | jq -r '.result.pane.terminal_title // ""')"
    case "$title" in *@*:*|"") ;; *) return 0 ;; esac   # something is already running there
  fi
  herdr pane send-text "$pane" "$2"
  herdr pane send-keys "$pane" enter
}

ensure_views() {  # $1 = focus | nofocus
  local ws req mine fresh_req=fresh first
  ws="$(herdr workspace list | jq -r --arg l "$LABEL" '[.result.workspaces[] | select(.label==$l)] | first | .workspace_id // empty')"
  if [ -z "$ws" ]; then
    local out
    out="$(herdr workspace create --label "$LABEL" --cwd "$ROOT" --no-focus)"
    ws="$(jq -r '.result.workspace.workspace_id' <<<"$out")"
    req="$(jq -r '.result.tab.tab_id' <<<"$out")"
    herdr tab rename "$req" requested >/dev/null
  else
    fresh_req=""
    req="$(view_tab "$ws" requested)"
    if [ -z "$req" ]; then   # first start with this layout: the existing first tab becomes "requested"
      first="$(herdr tab list | jq -r --arg w "$ws" '[.result.tabs[] | select(.workspace_id==$w)] | first | .tab_id // empty')"
      req="$first"
      [ -n "$req" ] && herdr tab rename "$req" requested >/dev/null
    fi
  fi
  mine="$(view_tab "$ws" mine)"
  if [ -z "$mine" ]; then
    mine="$(herdr tab create --workspace "$ws" --cwd "$ROOT" --label mine --no-focus | jq -r '.result.tab.tab_id')"
    start_view "$mine" "review-queue --mine" fresh
  else
    start_view "$mine" "review-queue --mine"
  fi
  [ -n "$req" ] && start_view "$req" "review-queue" $fresh_req
  [ -n "$req" ] && herdr tab rename "$req" requested >/dev/null   # again: the tab-titles plugin may have renamed it meanwhile
  if [ "$1" = focus ]; then
    herdr workspace focus "$ws" >/dev/null
    [ -n "$req" ] && herdr tab focus "$req" >/dev/null
  fi
}

ensure_workspace() { ensure_views focus; }

# Startup hook: wait for herdr to finish restoring the session, then bring the views back. No focus change.
restore_workspace() { sleep 2; ensure_views nofocus; }

run_ui() {  # args are passed to ui.py (e.g. --mine)
  # Restart the UI if it crashes (non-zero); `q` exits 0 and ends the loop.
  while true; do
    python3 "$HERE/ui.py" "$@"
    rc=$?
    [ "$rc" -eq 0 ] && break
    echo "review-queue UI exited ($rc), restarting in 2s…" >&2
    sleep 2
  done
}

case "${1:-}" in
  --open)      ACTION="${3:-review}"; open_review "${2:-}" ;;
  --open-tab)  open_review_tab "${2:-}" ;;
  --workspace) ensure_workspace ;;
  --restore)   restore_workspace ;;
  --mine)      run_ui --mine ;;
  *)           run_ui ;;
esac
