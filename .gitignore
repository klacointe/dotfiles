*.swp
/vim/plugged
/vim/.netrwhist
/git/sources
/nvim/autoload/plugged/
/nvim/.netrwhist

# Fonts
/fonts/.uuid
/fonts/*/.uuid

# IPTVnator: the database stores Xtream credentials in CLEAR TEXT
# (playlists table: serverUrl, username, password) — never version it.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
/iptvnator/config.json
/iptvnator/backups/

# --- Credentials: never version these ---------------------------------------
# First line of defence (covers a careless `git add .`). The gitleaks hooks in
# githooks/ take over for whatever slips through.

# Private keys and certificates
*.pem
*.pfx
*.p12
*.jks
*.keystore
id_rsa
id_dsa
id_ecdsa
id_ed25519
*_rsa
*_ed25519

# Environment files
.env
.env.*
!.env.example
!.env.sample
*.env.local

# Credentials of tools commonly symlinked from a dotfiles repo
.netrc
.npmrc
.pypirc
.aws/credentials
.docker/config.json
**/kubeconfig
**/*.kubeconfig
.gnupg/
secrets.yml
secrets.yaml
secrets.json

# Local convention: anything suffixed .local or placed under private/ stays on
# the machine. That is where sensitive values belong.
*.local
/private/
