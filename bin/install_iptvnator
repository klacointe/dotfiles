#!/usr/bin/env bash
#
# Install IPTVnator from the upstream .deb instead of the snap.
#
# Why not the snap: it ships with strict confinement and no interface that
# allows executing a host binary, so AppArmor denies the exec and external
# players never start:
#
#   apparmor="DENIED" operation="exec" profile="snap.iptvnator.iptvnator"
#   name="/snap/snapd/.../usr/bin/snap" comm="iptvnator.bin"
#
# The .deb runs unconfined, so MPV / VLC launch normally, and it also carries
# the embedded-MPV runtime (libmpv2) that the snap lacks.
#
# Safe to re-run: skips the download when the target version is already
# installed, and never deletes data.
#
# Usage:
#   bin/install_iptvnator                 # install/update + migrate snap data
#   bin/install_iptvnator --remove-snap   # also drop the snap once migrated
#   bin/install_iptvnator --version 0.23.0
set -euo pipefail

REPO="4gray/iptvnator"
DOTFILES="${DOTFILES:-$HOME/dotfiles}"
DESKTOP_SRC="$DOTFILES/iptvnator/iptvnator.desktop"
DESKTOP_DST="$HOME/.local/share/applications/iptvnator.desktop"

SNAP_HOME="$HOME/snap/iptvnator/current"
NATIVE_DB_DIR="$HOME/.iptvnator/databases"
BACKUP_DIR="$HOME/.iptvnator/backups"

REMOVE_SNAP=0
VERSION=""

while [ $# -gt 0 ]; do
    case "$1" in
        --remove-snap) REMOVE_SNAP=1 ;;
        --version) VERSION="${2:-}"; shift ;;
        -h|--help) sed -n '2,22p' "$0"; exit 0 ;;
        *) echo "!! unknown option: $1" >&2; exit 1 ;;
    esac
    shift
done

say() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }
die() { printf '\033[1;31m!!\033[0m %s\n' "$*" >&2; exit 1; }

for c in curl dpkg python3; do
    command -v "$c" >/dev/null || die "missing required command: $c"
done

[ "$(dpkg --print-architecture)" = amd64 ] \
    || warn "architecture is $(dpkg --print-architecture), the URL below targets amd64"

# --- 1. resolve the version to install -------------------------------------
if [ -z "$VERSION" ]; then
    say "Looking up the latest release on GitHub"
    VERSION=$(curl -fsSL --max-time 20 "https://api.github.com/repos/$REPO/releases/latest" \
        | python3 -c 'import json,sys; print(json.load(sys.stdin)["tag_name"].lstrip("v"))') \
        || die "could not reach the GitHub API (use --version X.Y.Z)"
fi
say "Target version: $VERSION"

INSTALLED=$(dpkg-query -W -f='${Version}' iptvnator 2>/dev/null || true)
if [ "$INSTALLED" = "$VERSION" ] && [ -x /opt/IPTVnator/iptvnator ]; then
    say "iptvnator $VERSION already installed, nothing to download"
else
    DEB="iptvnator-${VERSION}-linux-amd64.deb"
    URL="https://github.com/$REPO/releases/download/v${VERSION}/${DEB}"
    TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT

    say "Downloading $DEB (~130 MB)"
    curl -fL --progress-bar --max-time 600 -o "$TMP/$DEB" "$URL" \
        || die "download failed: $URL"
    dpkg-deb -I "$TMP/$DEB" >/dev/null 2>&1 || die "downloaded file is not a valid .deb"

    # The app must not be running while dpkg swaps /opt/IPTVnator.
    if pgrep -x iptvnator.bin >/dev/null; then
        warn "IPTVnator is running — quit it and re-run this script"
        exit 1
    fi

    say "Installing (pulls libmpv2, libsixel1, libxpresent1)"
    sudo apt-get update -qq
    sudo apt-get install -y "$TMP/$DEB"
fi

# --- 2. migrate data from the snap -----------------------------------------
# The snap sees $HOME=~/snap/iptvnator/current, so its SQLite database lives in
# ~/snap/iptvnator/current/.iptvnator/ and NOT in ~/.config/IPTVnator. Copying
# only the Electron profile silently loses every playlist.
if [ -d "$SNAP_HOME" ]; then
    if pgrep -x iptvnator.bin >/dev/null; then
        warn "IPTVnator is running — skipping data migration"
    else
        mkdir -p "$BACKUP_DIR"

        if [ -d "$SNAP_HOME/.config/IPTVnator" ] && [ ! -d "$HOME/.config/IPTVnator" ]; then
            say "Migrating the Electron profile"
            cp -a "$SNAP_HOME/.config/IPTVnator" "$HOME/.config/IPTVnator"
        fi

        snap_db="$SNAP_HOME/.iptvnator/databases/iptvnator.db"
        if [ -f "$snap_db" ] && [ ! -f "$NATIVE_DB_DIR/iptvnator.db" ]; then
            say "Migrating the database (playlists, EPG, favourites)"
            mkdir -p "$NATIVE_DB_DIR"
            # SQLite backup API rather than cp: folds in any pending -wal.
            python3 - "$snap_db" "$NATIVE_DB_DIR/iptvnator.db" <<'PY'
import sqlite3, sys
src = sqlite3.connect(f"file:{sys.argv[1]}?mode=ro", uri=True)
dst = sqlite3.connect(sys.argv[2])
src.backup(dst); dst.close(); src.close()
PY
            rm -f "$NATIVE_DB_DIR/iptvnator.db-wal" "$NATIVE_DB_DIR/iptvnator.db-shm"
        elif [ -f "$snap_db" ]; then
            say "Native database already present, skipping migration"
            say "  (to force: move $NATIVE_DB_DIR/iptvnator.db away and re-run)"
        fi
    fi
fi

# --- 3. embedded-MPV frame-copy engine -------------------------------------
# Without this, "Embedded MPV" is hidden on Wayland: getSupport() requires
# X11/Xwayland unless the frame-copy engine is active. Picked up on the next
# start only — the window sandbox is fixed at creation time.
say "Enabling the frame-copy engine (embedded MPV on Wayland)"
python3 - <<'PY'
import json, os
p = os.path.expanduser("~/.config/IPTVnator/config.json")
os.makedirs(os.path.dirname(p), exist_ok=True)
try:
    with open(p) as f: cfg = json.load(f)
except Exception:
    cfg = {}
if cfg.get("EMBEDDED_MPV_FRAME_COPY") is not True:
    cfg["EMBEDDED_MPV_FRAME_COPY"] = True
    with open(p, "w") as f: json.dump(cfg, f, indent="\t")
    print("    EMBEDDED_MPV_FRAME_COPY = true")
else:
    print("    already enabled")
PY

# --- 4. menu entry ----------------------------------------------------------
# The packaged one has Categories=Video; without AudioVideo, which
# desktop-file-validate reports as an error. Ours takes precedence.
if [ -f "$DESKTOP_SRC" ]; then
    say "Installing the menu entry"
    mkdir -p "$(dirname "$DESKTOP_DST")"
    ln -snf "$DESKTOP_SRC" "$DESKTOP_DST"
    command -v update-desktop-database >/dev/null \
        && update-desktop-database "$(dirname "$DESKTOP_DST")" 2>/dev/null || true
else
    warn "$DESKTOP_SRC not found, menu entry not installed"
fi

# --- 5. snap ----------------------------------------------------------------
# Nothing to do on a machine that never had the snap (or has no snapd at all).
if command -v snap >/dev/null 2>&1 && snap list iptvnator >/dev/null 2>&1; then
    if [ "$REMOVE_SNAP" = 1 ]; then
        say "Removing the snap (snapd keeps a snapshot)"
        sudo snap remove iptvnator
    else
        warn "The snap is still installed; its launcher reproduces the original bug."
        warn "  Once the native build checks out:  sudo snap remove iptvnator"
        warn "  or re-run with:                    $0 --remove-snap"
    fi
fi

say "Done — launch IPTVnator from the applications menu"
say "  Settings -> Video player -> 'Embedded MPV' or 'MPV'"
