{
  "reposDir": "~/dev/WTTJ",
  "github": {
    "enabled": true
  },
  "tickets": {
    "enabled": true,
    "keys": [
      "PLA"
    ],
    "name": "Linear",
    "server": "claude.ai Linear"
  },
  "ci": {
    "enabled": true,
    "name": "CircleCI",
    "server": "claude.ai CircleCI"
  },
  "calendar": {
    "enabled": true,
    "name": "Calendar",
    "server": "claude.ai Google Calendar"
  },
  "platform": {
    "enabled": true,
    "name": "Backstage",
    "server": "backstage",
    "tools": {
      "deployStatus": {
        "tool": "ship_get-deploy-status",
        "args": {
          "env": "production"
        }
      },
      "deployHistory": {
        "tool": "ship_list-deployments",
        "args": {
          "env": "production",
          "appId": "{appId}"
        }
      }
    },
    "fields": {
      "apps": "apps",
      "appId": "id",
      "appRepo": "githubRepoUrl",
      "appLink": "argoUrl",
      "appTag": "imageTag|branch",
      "appSha": "commitSha",
      "deployments": "deployments",
      "deployWorkflow": "workflowName",
      "deployNamespace": "namespace",
      "deployTag": "tag",
      "deployBranch": "branch"
    }
  },
  "datadog": {
    "server": "claude.ai Datadog"
  },
  "mail": {
    "enabled": true,
    "name": "Gmail",
    "server": "claude.ai Gmail"
  },
  "e2eBrowser": "terminal-browser",
  "spaces": [
    "inbox",
    {
      "name": "reviews",
      "cwd": "~/dev/WTTJ",
      "icon": ""
    },
    "terminal",
    "actions",
    "to-do",
    "runbook",
    "meetings",
    "monitor",
    "routines",
    "review",
    "mail",
    {
      "name": "dotfiles",
      "cwd": "~/dotfiles",
      "icon": "",
      "key": "prefix+shift+d"
    }
  ],
  "agents": {
    "default": "claude"
  },
  "frontend": "tui",
  "deployWatch": {
    "enabled": true,
    "afterMinutes": 30,
    "tools": [
      "mcp__claude_ai_Datadog"
    ]
  },
  "density": "comfortable",
  "monitor": {
    "releaseDays": 7
  }
}
